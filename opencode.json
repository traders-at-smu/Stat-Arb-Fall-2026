{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AI.md"],
  "permission": {
    "*": "allow",
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "rm -fr *": "deny",
      "* rm -rf *": "deny",
      "* rm -fr *": "deny",
      "git branch -D *": "deny",
      "* git branch -D *": "deny",
      "git branch --delete --force *": "deny",
      "* git branch --delete --force *": "deny",
      "git push --force*": "deny",
      "* git push*--force*": "deny",
      "git push -f*": "deny",
      "* git push*-f *": "deny",
      "* git push*-f": "deny",
      "Remove-Item*-Recurse*-Force*": "deny",
      "Remove-Item*-Force*-Recurse*": "deny"
    }
  }
}
